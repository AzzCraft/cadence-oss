#!/usr/bin/env bash
# cadence-sandbox audit hook
# Inspects a sandbox profile declaration; does not observe runtime isolation.
# Usage: audit-hook <profile.json> [output_dir]
set -euo pipefail

PROFILE="${1:?Usage: audit-hook <profile.json> [output_dir]}"
OUTDIR="${2:-.cadence/sandbox-audit}"

if [[ ! -f "$PROFILE" ]]; then
  echo "audit-hook: profile not found: $PROFILE" >&2
  exit 1
fi

mkdir -p "$OUTDIR"

VIOLATIONS=0
AUDIT_FILE="$OUTDIR/audit-$(python3 - <<'PY'
import uuid
print(uuid.uuid4().hex)
PY
).json"

python3 - "$PROFILE" "$AUDIT_FILE" <<'PYEOF'
import json, sys
from datetime import datetime, timezone

profile_path = sys.argv[1]
audit_path = sys.argv[2]

with open(profile_path) as f:
    profile = json.load(f)

if not isinstance(profile, dict) or not isinstance(profile.get("schemaVersion"), str):
    raise SystemExit("audit-hook: invalid profile declaration")
profile_id = profile.get("profileId") or profile.get("sandboxId")
if not isinstance(profile_id, str) or not profile_id or "filesystem" not in profile or "timeSource" not in profile or not ("network" in profile or "networkAccess" in profile):
    raise SystemExit("audit-hook: missing profile identity/filesystem/network/timeSource")
findings = [
    {"check": "filesystem", "declaration": profile["filesystem"], "status": "declared"},
    {"check": "network", "declaration": profile.get("network", profile.get("networkAccess")), "status": "declared"},
    {"check": "timeSource", "declaration": profile["timeSource"], "status": "declared"},
]
resources = profile.get("resources", profile.get("limits"))
if resources is not None:
    findings.append({"check": "resources", "declaration": resources, "status": "declared"})
violations = 0

audit = {
    "schemaVersion": "1.0.0",
    "profileId": profile_id,
    "timestamp": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "findings": findings,
    "summary": {
        "totalChecks": len(findings),
        "violations": violations,
        "status": "not_observed",
        "configurationStatus": "valid",
        "executionAudit": "not_run"
    }
}

with open(audit_path, "w") as f:
    json.dump(audit, f, indent=2)
    f.write("\n")

print(f"audit-hook: {audit['summary']['totalChecks']} checks, {violations} violations -> {audit['summary']['status']}")
sys.exit(1 if violations > 0 else 0)
PYEOF
