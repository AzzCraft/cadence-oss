{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzcraft.com/cadence/sandbox/profiles/ci-container.json",
  "task": "DAS-04-011",
  "schemaVersion": "1.0.0",
  "profileId": "ci-container",
  "backend": "container-runtime",
  "description": "CI profile — container-isolated, read-only inputs, network disabled, resource bounded.",
  "filesystem": {
    "mode": "container-isolated",
    "readOnlyInputs": true,
    "writableOutputDir": "/workspace/.cadence/out"
  },
  "network": {
    "access": false
  },
  "resources": {
    "cpuLimit": 2,
    "memoryLimitMB": 4096,
    "pidsLimit": 256,
    "timeoutSeconds": 600
  },
  "timeSource": "injected",
  "escapeClassification": {
    "networkViolation": "hard_fail",
    "filesystemViolation": "hard_fail",
    "resourceExceeded": "hard_fail"
  }
}
