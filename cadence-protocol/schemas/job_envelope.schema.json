{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzcraft.com/cadence/schemas/job_envelope.schema.json",
  "title": "JobEnvelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "jobId": {
      "type": "string"
    },
    "jobType": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "degraded",
        "cancelled"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlation": {
      "$ref": "common.schema.json#/$defs/correlation"
    },
    "profileId": {
      "type": "string"
    },
    "configId": {
      "type": "string"
    },
    "configHash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "sideEffectsMode": {
      "type": "string",
      "enum": [
        "dryRun",
        "sandbox",
        "live"
      ]
    },
    "inputRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rawInputId": {
          "type": "string"
        },
        "inputHash": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "snapshotId": {
          "type": "string"
        }
      },
      "required": [
        "rawInputId"
      ],
      "anyOf": [
        {
          "required": [
            "inputHash"
          ]
        },
        {
          "required": [
            "snapshotId"
          ]
        }
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "manifestRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runId": {
                "type": "string"
              },
              "manifestHash": {
                "$ref": "common.schema.json#/$defs/sha256"
              }
            },
            "required": [
              "runId",
              "manifestHash"
            ]
          },
          "result": {
            "$ref": "pipeline_result.schema.json"
          }
        },
        "required": [
          "attempt",
          "startedAt",
          "finishedAt",
          "manifestRef",
          "result"
        ]
      }
    },
    "diagnostics": {
      "$ref": "common.schema.json#/$defs/diagnostics"
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/errorEnvelope"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "jobType",
    "status",
    "createdAt",
    "updatedAt",
    "profileId",
    "sideEffectsMode",
    "runs"
  ]
}
