{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzcraft.com/cadence/schemas/tooling_lock.schema.json",
  "title": "ToolingLock",
  "description": "Vendor lock file specifying pinned tool versions for deterministic builds",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "pins": {
      "type": "object",
      "description": "Map of tool name to pinned version string",
      "additionalProperties": { "type": "string" }
    },
    "components": {
      "type": "object",
      "description": "Legacy alias for pins",
      "additionalProperties": { "type": "string" }
    },
    "note": { "type": "string" }
  },
  "required": ["schemaVersion"],
  "additionalProperties": false
}
