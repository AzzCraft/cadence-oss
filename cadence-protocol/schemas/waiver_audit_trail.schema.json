{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzcraft.com/cadence/schemas/waiver_audit_trail.schema.json",
  "title": "WaiverAuditTrail",
  "description": "Governance decisions recorded for a waiver review path.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "ticket": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "enum": ["check", "policy-pack", "profile"] },
    "referenceTime": { "type": "string", "format": "date-time" },
    "escalationLevel": { "type": "string", "enum": ["none", "tier1", "tier2"] },
    "requiredChainDepth": { "type": "integer", "minimum": 1 },
    "actualChainDepth": { "type": "integer", "minimum": 0 },
    "compliant": { "type": "boolean" },
    "approvalChain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "waiverTicket": { "type": "string", "minLength": 1 },
        "depth": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "identity": { "type": "string", "minLength": 1 },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["role", "identity", "timestamp"]
          }
        }
      },
      "required": ["waiverTicket", "depth", "entries"]
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "message": { "type": "string" }
        },
        "required": ["check", "status"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "ticket",
    "scope",
    "referenceTime",
    "escalationLevel",
    "requiredChainDepth",
    "actualChainDepth",
    "compliant",
    "approvalChain",
    "decisions"
  ]
}
