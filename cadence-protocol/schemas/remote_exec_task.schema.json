{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzcraft.com/schemas/remote_exec_task.schema.json",
  "title": "RemoteExecTaskEnvelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskId",
    "profile",
    "inputs",
    "security"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "profile": {
      "type": "string",
      "enum": [
        "pr",
        "nightly",
        "release",
        "full"
      ]
    },
    "inputs": {
      "type": "object"
    },
    "security": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
