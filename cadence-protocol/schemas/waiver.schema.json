{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzcraft.example/schemas/waiver.schema.json",
  "title": "Cadence Waiver",
  "type": "object",
  "required": [
    "id",
    "scope",
    "reason",
    "approvedBy",
    "expiresAt",
    "signature"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "approvedBy": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "followUpTicket": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
