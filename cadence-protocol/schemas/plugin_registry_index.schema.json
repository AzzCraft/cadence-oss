{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzcraft.com/cadence/schemas/plugin_registry_index.schema.json",
  "title": "PluginRegistryIndex",
  "description": "Canonical v9 name. `registry_entry` remains a deprecated compatibility alias for one release cycle.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "registryId": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string" },
          "id": { "type": "string" },
          "ref": { "type": "string" }
        },
        "required": ["kind", "id", "ref"]
      }
    }
  },
  "required": ["schemaVersion", "registryId", "entries"]
}
