{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.dev/schemas/cad002-evidence-bundle-v1",
  "title": "Historical CAD-002 diagnostic envelope; expected fields are fixture metadata only",
  "type": "object",
  "required": [
    "task",
    "schemaVersion",
    "chainRef",
    "artifactPaths"
  ],
  "properties": {
    "task": {
      "const": "CAD-002"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "chainRef": {
      "type": "string",
      "minLength": 1
    },
    "artifactPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedResult": {
      "type": "object"
    },
    "expectedFailure": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
