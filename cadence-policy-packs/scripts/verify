#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

export PYTHONDONTWRITEBYTECODE=1
export PYTEST_ADDOPTS=
echo "[cadence-policy-packs] validate declared packs"
python3 - <<'PYVALIDATE'
from pathlib import Path
try:
    import yaml
except ImportError as exc:
    raise SystemExit("install cadence-oss/requirements-verify.txt before verification (PyYAML required)") from exc

required = {'core-v146-baseline', 'headless-v146', 'standard-ui-v146', 'hfvi-v146'}
files = sorted(Path('packs').rglob('pack.yaml'))
if not files or not required <= {p.parent.name for p in files}:
    raise SystemExit('required policy packs are missing')
for path in files:
    data = yaml.safe_load(path.read_text())
    if not isinstance(data, dict):
        raise SystemExit(f'{path}: pack must be a mapping')
    for key in ('id', 'schemaVersion', 'version', 'channel'):
        if not isinstance(data.get(key), str) or not data[key]:
            raise SystemExit(f'{path}: {key} must be a non-empty string')
    runtime = data.get('runtimeCompatibility')
    if not isinstance(runtime, dict) or any(not isinstance(runtime.get(k), str) or not runtime[k] for k in ('cadenceCore', 'protocol')):
        raise SystemExit(f'{path}: runtime compatibility is missing')
    if not isinstance(data.get('rules'), list) or not data['rules']:
        raise SystemExit(f'{path}: rules must be a non-empty list')
print(f'OK: {len(files)} policy packs validated')
PYVALIDATE

legacy_pack="current-baseline""-baseline"
if grep -R -n --binary-files=without-match -- "$legacy_pack" packs >/dev/null 2>&1; then
  echo "legacy unified baseline reference remains under packs/" >&2
  exit 1
fi

python3 -B -m pytest -q -p no:cacheprovider tests

echo "[cadence-policy-packs] OK"
