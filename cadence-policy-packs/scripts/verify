#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

echo "[cadence-policy-packs] validate pack.yaml (lightweight)"
PACKS=(
  "packs/core-v140-baseline/pack.yaml"
  "packs/headless-v140/pack.yaml"
  "packs/standard-ui-v140/pack.yaml"
  "packs/hfvi-v140/pack.yaml"
)

for PACK in "${PACKS[@]}"; do
  [ -f "$PACK" ] || { echo "missing $PACK"; exit 2; }
  grep -qE '^id:' "$PACK" || { echo "$PACK missing id"; exit 2; }
  grep -qE '^schemaVersion:' "$PACK" || { echo "$PACK missing schemaVersion"; exit 2; }
  grep -qE '^version:' "$PACK" || { echo "$PACK missing version"; exit 2; }
  grep -qE '^channel:' "$PACK" || { echo "$PACK missing channel"; exit 2; }
  grep -qE '^runtimeCompatibility:' "$PACK" || { echo "$PACK missing runtimeCompatibility"; exit 2; }
  grep -qE '^  cadenceCore:' "$PACK" || { echo "$PACK missing runtimeCompatibility.cadenceCore"; exit 2; }
  grep -qE '^  protocol:' "$PACK" || { echo "$PACK missing runtimeCompatibility.protocol"; exit 2; }
  grep -qE '^  dasStandard:' "$PACK" || { echo "$PACK missing runtimeCompatibility.dasStandard"; exit 2; }
  grep -qE '^rules:' "$PACK" || { echo "$PACK missing rules"; exit 2; }
done

if grep -R -n -E --binary-files=without-match 'v146|1\\.4\\.6' packs >/dev/null 2>&1; then
  echo "mistaken v1.4.6 policy identifier or version remains under packs/" >&2
  exit 1
fi

echo "[cadence-policy-packs] OK"
