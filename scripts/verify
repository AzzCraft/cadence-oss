#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ "${1:-}" == "--standalone" ]]; then
  shift
fi
if [[ $# -ne 0 ]]; then
  echo "Usage: scripts/verify [--standalone]" >&2
  exit 2
fi
command -v go >/dev/null 2>&1 || { echo "Go 1.25.12 or newer is required." >&2; exit 127; }
MIN_GO="go1.25.12"
ACTUAL_GO="$(go env GOVERSION)"
if [[ "$(printf '%s\n' "$MIN_GO" "$ACTUAL_GO" | sort -V | head -n 1)" != "$MIN_GO" ]]; then
  echo "Go 1.25.12 or newer is required; found $ACTUAL_GO." >&2
  exit 1
fi
export GOFLAGS="${GOFLAGS:+$GOFLAGS }-buildvcs=false"
bash ./cadence-core/scripts/verify
