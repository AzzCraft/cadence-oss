#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

mode="${1:---full}"
if [[ $# -gt 1 || ( "$mode" != "--standalone" && "$mode" != "--full" ) ]]; then
  echo "Usage: scripts/verify [--standalone|--full]" >&2
  exit 2
fi
command -v go >/dev/null 2>&1 || { echo "Go 1.26.9 or newer is required." >&2; exit 127; }

# A developer machine can have an unavailable or broken default Go cache
# (including a stale symlink to detached storage). Keep verification portable
# by falling back to a disposable cache without mutating machine-global state.
CADENCE_OSS_TEMP_GO_CACHE=""
cleanup_go_cache() {
  if [[ -n "$CADENCE_OSS_TEMP_GO_CACHE" && -d "$CADENCE_OSS_TEMP_GO_CACHE" ]]; then
    rm -rf -- "$CADENCE_OSS_TEMP_GO_CACHE"
  fi
}
if [[ -z "${GOCACHE:-}" ]]; then
  DEFAULT_GO_CACHE="$(go env GOCACHE)"
  if [[ -d "$DEFAULT_GO_CACHE" && -w "$DEFAULT_GO_CACHE" ]]; then
    export GOCACHE="$DEFAULT_GO_CACHE"
  else
    CADENCE_OSS_TEMP_GO_CACHE="$(mktemp -d "${TMPDIR:-/tmp}/cadence-oss-go-cache.XXXXXX")"
    export GOCACHE="$CADENCE_OSS_TEMP_GO_CACHE"
    trap cleanup_go_cache EXIT
  fi
fi

MIN_GO="go1.26.9"
ACTUAL_GO="$(go env GOVERSION)"
if [[ "$(printf '%s\n' "$MIN_GO" "$ACTUAL_GO" | sort -V | head -n 1)" != "$MIN_GO" ]]; then
  echo "Go 1.26.9 or newer is required; found $ACTUAL_GO." >&2
  exit 1
fi
export GOFLAGS="${GOFLAGS:+$GOFLAGS }-buildvcs=false"
case "$mode" in
  --standalone)
    bash ./cadence-core/scripts/verify
    ;;
  --full)
    command -v node >/dev/null 2>&1 || { echo "Node.js is required for the full Cadence OSS verifier." >&2; exit 127; }
    command -v python3 >/dev/null 2>&1 || { echo "Python 3 is required for the full Cadence OSS verifier." >&2; exit 127; }
    bash ./verify_all.sh
    ;;
esac
