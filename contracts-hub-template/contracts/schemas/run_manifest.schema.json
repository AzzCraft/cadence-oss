{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzcraft.com/cadence/schemas/run_manifest.schema.json",
  "title": "RunManifest",
  "type": "object",
  "additionalProperties": true,
  "not": {
    "required": [
      "manifestHash"
    ]
  },
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "runId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlation": {
      "$ref": "common.schema.json#/$defs/correlation"
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ]
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profileId": {
          "type": "string"
        },
        "configId": {
          "type": "string"
        },
        "configHash": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "profileId"
      ],
      "anyOf": [
        {
          "required": [
            "configId"
          ]
        },
        {
          "required": [
            "configHash"
          ]
        }
      ]
    },
    "inputRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rawInputId": {
          "type": "string"
        },
        "inputHash": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "snapshotId": {
          "type": "string"
        }
      },
      "required": [
        "rawInputId"
      ],
      "anyOf": [
        {
          "required": [
            "inputHash"
          ]
        },
        {
          "required": [
            "snapshotId"
          ]
        }
      ]
    },
    "sideEffectsMode": {
      "type": "string",
      "enum": [
        "dryRun",
        "sandbox",
        "live"
      ]
    },
    "determinism": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "tier0",
            "tier1",
            "tier2"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "concurrency": {
          "type": "object"
        }
      },
      "required": [
        "tier"
      ]
    },
    "budget": {
      "$ref": "common.schema.json#/$defs/budget"
    },
    "stageSummaries": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stageSummary"
      }
    },
    "diagnostics": {
      "$ref": "common.schema.json#/$defs/diagnostics"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "pipeline",
    "algorithm",
    "contracts",
    "config",
    "inputRef",
    "sideEffectsMode",
    "determinism",
    "budget"
  ]
}
