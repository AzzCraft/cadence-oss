#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

python3 - <<'PY'
from __future__ import annotations

import json
from pathlib import Path


def fail(message: str) -> None:
    raise SystemExit(f"bootstrap required: {message}. Run tools/bootstrap_locks.py first.")


cadence_lock = json.loads(Path("cadence_lock.json").read_text(encoding="utf-8"))
cadence_version = str(cadence_lock.get("cadence_cli", {}).get("version", "missing"))
if cadence_version in {"missing", ""}:
    fail(f"cadence_lock.json still contains unresolved version ({cadence_version})")

closure = json.loads(Path("suite_version_closure.json").read_text(encoding="utf-8"))
suite_version = str(closure.get("suiteVersion", "missing"))
if suite_version in {"missing", ""}:
    fail(f"suite_version_closure.json still contains unresolved suiteVersion ({suite_version})")

tooling = json.loads(Path("tooling_lock.json").read_text(encoding="utf-8"))
pins = tooling.get("pins")
if not isinstance(pins, dict) or not pins:
    fail("tooling_lock.json pins are empty")
if closure.get("componentVersions", {}).get("cadence_cli") != cadence_version or pins.get("cadenceCliVersion") != cadence_version:
    fail("cadence_cli version differs across cadence_lock, closure and tooling pins")
if pins.get("suiteVersion") != suite_version:
    fail("suiteVersion differs across closure and tooling pins")
PY

echo "[contracts-hub-template] contract completeness (schema + semantics + fixtures + checks + ids)"
python3 ./contracts/scripts/verify.py
if [[ "${CADENCE_TEMPLATE_VERIFY_SKIP_TESTS:-0}" != "1" ]]; then
  python3 -m unittest discover -s tests -p 'test_*.py'
fi
echo "[contracts-hub-template] OK"
