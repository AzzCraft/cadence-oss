#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

export GOPROXY=off
export GOSUMDB=off
if [[ -n "${GOFLAGS:-}" ]]; then
  export GOFLAGS="${GOFLAGS} -mod=vendor"
else
  export GOFLAGS="-mod=vendor"
fi

bash ./scripts/verify --full
bash ./scripts/replay --help >/dev/null
bash ./scripts/sign-evidence --help >/dev/null
bash ./scripts/verify-signature --help >/dev/null


python3 - <<'PY'
from pathlib import Path
import sys

root = Path.cwd()
repo_root = root.parent
required_internal_units = [
    repo_root / "cadence-sandbox" / "runtime_profile.json",
    repo_root / "cadence-sandbox" / "sandbox_profile.json",
    repo_root / "cadence-registry" / "registry.json",
]
missing = [p.relative_to(repo_root).as_posix() for p in required_internal_units if not p.exists()]
if missing:
    print("missing internal unit inputs:\n- " + "\n- ".join(missing), file=sys.stderr)
    raise SystemExit(1)
PY

legacy_pack="current-baseline""-baseline"
if grep -R -n --binary-files=without-match -- "$legacy_pack" . ../cadence-examples ../cadence-policy-packs >/dev/null 2>&1; then
  echo "legacy unified baseline reference remains in cadence-core scope" >&2
  exit 1
fi
