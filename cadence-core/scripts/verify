#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
export PYTHONDONTWRITEBYTECODE=1
export PYTEST_ADDOPTS=
case "${1:-}" in
  "") test_freshness=() ;;
  --full) test_freshness=(-count=1 -timeout=120s) ;;
  *) echo "Usage: scripts/verify [--full]" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || exit 2

export CGO_ENABLED=0
export GOPROXY=off
export GOSUMDB=off
if [[ -n "${GOFLAGS:-}" ]]; then
  export GOFLAGS="${GOFLAGS} -mod=vendor"
else
  export GOFLAGS="-mod=vendor"
fi

make_temp_dir() {
  local prefix="$1"
  local base="${TMPDIR:-/tmp}"
  local dir=""
  if dir="$(mktemp -d "${base}/${prefix}.XXXXXX" 2>/dev/null)"; then
    printf '%s\n' "$dir"
    return 0
  fi
  python3 - "$prefix" "$base" <<'PY'
import sys
import tempfile

print(tempfile.mkdtemp(prefix=sys.argv[1] + ".", dir=sys.argv[2]))
PY
}

python3 ../tools/generate_build_identity.py --check

echo "[cadence-core] go test"
go test ./... "${test_freshness[@]}"

echo "[cadence-core] go vet"
go vet ./...

echo "[cadence-core] build"
tmpdir="$(make_temp_dir cadence-core)"
trap 'rm -rf "$tmpdir"' EXIT
go build -o "$tmpdir/cadence" ./cmd/cadence

if [[ "${1:-}" == "--full" ]]; then
  python3 -B -m pytest -q -p no:cacheprovider tests
fi

echo "[cadence-core] OK"
