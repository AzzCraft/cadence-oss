#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  CADENCE_SIGNING_KEY=... scripts/verify-signature --input ENVELOPE [--payload FILE]
  CADENCE_SIGNING_KEY=... scripts/verify-signature --bundle DIR

Verifies one Cadence HMAC-SHA256 signature envelope or a bundle of detached
signatures plus bundle-signature.json.
The development-only HMAC key is read only from CADENCE_SIGNING_KEY. Do not
place signing keys in command-line arguments.
USAGE
}

INPUT=""
PAYLOAD=""
BUNDLE=""
KEY="${CADENCE_SIGNING_KEY:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --input)
      INPUT="${2:-}"
      shift 2
      ;;
    --payload)
      PAYLOAD="${2:-}"
      shift 2
      ;;
    --bundle)
      BUNDLE="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ -z "$KEY" ]]; then
  usage
  exit 2
fi

if [[ -n "$BUNDLE" ]]; then
  CADENCE_SIGNING_KEY="$KEY" python3 - "$BUNDLE" <<'PY'
import hashlib
import hmac
import json
import stat
import sys
from pathlib import Path, PurePosixPath

bundle_dir = Path(sys.argv[1]).resolve(strict=True)
if not bundle_dir.is_dir():
    raise SystemExit("bundle is not a directory")
key = __import__("os").environ["CADENCE_SIGNING_KEY"].encode("utf-8")

def safe_read(name):
    if not isinstance(name, str) or not name or "\\" in name:
        raise SystemExit(f"unsafe bundle entry: {name!r}")
    pure = PurePosixPath(name)
    if pure.is_absolute() or any(part in {"", ".", ".."} for part in pure.parts):
        raise SystemExit(f"unsafe bundle entry: {name!r}")
    path = bundle_dir.joinpath(*pure.parts)
    try:
        info = path.lstat()
    except OSError as exc:
        raise SystemExit(f"missing bundle entry {name}: {exc}") from exc
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise SystemExit(f"bundle entry is not a regular non-symlink file: {name}")
    resolved = path.resolve(strict=True)
    try:
        resolved.relative_to(bundle_dir)
    except ValueError as exc:
        raise SystemExit(f"bundle entry escapes bundle directory: {name}") from exc
    return resolved.read_bytes()

bundle_sig = json.loads(safe_read("bundle-signature.json"))
entries = bundle_sig["entries"]
if not isinstance(entries, dict) or not entries:
    raise SystemExit("bundle signature has no entries")

for name, expected_hash in sorted(entries.items()):
    payload = safe_read(name)
    actual_hash = "sha256:" + hashlib.sha256(payload).hexdigest()
    if actual_hash != expected_hash:
        raise SystemExit(f"payload hash mismatch for {name}: expected {expected_hash}, got {actual_hash}")
    envelope_name = f"{name}.signature.json"
    try:
        envelope = json.loads(safe_read(envelope_name))
    except SystemExit:
        if name != "run-manifest.json":
            raise
        envelope = json.loads(safe_read("manifest-signature.json"))
    expected_sig = hmac.new(key, actual_hash.encode("utf-8"), hashlib.sha256).hexdigest()
    if envelope["payloadHash"] != actual_hash or envelope["signature"] != expected_sig:
        raise SystemExit(f"detached signature verification failed for {name}")

combined = hashlib.sha256()
for name in sorted(entries):
    combined.update(name.encode("utf-8"))
    combined.update(b"\x00")
    combined.update(entries[name].encode("utf-8"))
    combined.update(b"\n")
expected_bundle_hash = "sha256:" + combined.hexdigest()
if bundle_sig["bundleHash"] != expected_bundle_hash:
    raise SystemExit("bundle hash verification failed")
expected_bundle_sig = hmac.new(key, expected_bundle_hash.encode("utf-8"), hashlib.sha256).hexdigest()
if bundle_sig["signature"] != expected_bundle_sig:
    raise SystemExit("bundle signature verification failed")
print("bundle signature verify: OK")
PY
  exit 0
fi

if [[ -z "$INPUT" ]]; then
  usage
  exit 2
fi

CADENCE_SIGNING_KEY="$KEY" python3 - "$INPUT" "$PAYLOAD" <<'PY'
import hashlib
import hmac
import json
import sys
from pathlib import Path

envelope = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
payload_path = Path(sys.argv[2]) if sys.argv[2] else None
key = __import__("os").environ["CADENCE_SIGNING_KEY"].encode("utf-8")

payload_hash = envelope["payloadHash"]
if payload_path is not None:
    payload_hash = "sha256:" + hashlib.sha256(payload_path.read_bytes()).hexdigest()
    if envelope["payloadHash"] != payload_hash:
        raise SystemExit("payload hash mismatch")

signature = envelope["signature"]
expected = hmac.new(key, payload_hash.encode("utf-8"), hashlib.sha256).hexdigest()
if not hmac.compare_digest(expected, signature):
    raise SystemExit("signature verification failed")
print("signature verify: OK")
PY
