#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  scripts/verify-signature --input ENVELOPE [--payload FILE] [--key VALUE]
  scripts/verify-signature --bundle DIR [--key VALUE]

Verifies one Cadence HMAC-SHA256 signature envelope or a bundle of detached
signatures plus bundle-signature.json.
Prefer CADENCE_SIGNING_KEY; explicit --key values are visible in the invoking command line.
USAGE
}

INPUT=""
PAYLOAD=""
BUNDLE=""
KEY="${CADENCE_SIGNING_KEY:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --input)
      INPUT="${2:-}"
      shift 2
      ;;
    --payload)
      PAYLOAD="${2:-}"
      shift 2
      ;;
    --bundle)
      BUNDLE="${2:-}"
      shift 2
      ;;
    --key)
      KEY="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ -z "$KEY" ]]; then
  usage
  exit 2
fi

export CADENCE_SIGNING_KEY="$KEY"

if [[ -n "$BUNDLE" ]]; then
  python3 - "$BUNDLE" <<'PY'
import hashlib
import os
import hmac
import json
import sys
from pathlib import Path

bundle_dir = Path(sys.argv[1])
key = os.environ["CADENCE_SIGNING_KEY"].encode("utf-8")

bundle_sig = json.loads((bundle_dir / "bundle-signature.json").read_text(encoding="utf-8"))
entries = bundle_sig["entries"]

for name, expected_hash in sorted(entries.items()):
    payload = (bundle_dir / name).read_bytes()
    actual_hash = "sha256:" + hashlib.sha256(payload).hexdigest()
    if actual_hash != expected_hash:
        raise SystemExit(f"payload hash mismatch for {name}: expected {expected_hash}, got {actual_hash}")
    envelope_path = bundle_dir / f"{name}.signature.json"
    if not envelope_path.exists() and name == "run-manifest.json":
        envelope_path = bundle_dir / "manifest-signature.json"
    envelope = json.loads(envelope_path.read_text(encoding="utf-8"))
    expected_sig = hmac.new(key, actual_hash.encode("utf-8"), hashlib.sha256).hexdigest()
    if envelope["payloadHash"] != actual_hash or envelope["signature"] != expected_sig:
        raise SystemExit(f"detached signature verification failed for {name}")

combined = hashlib.sha256()
for name in sorted(entries):
    combined.update(name.encode("utf-8"))
    combined.update(b"\x00")
    combined.update(entries[name].encode("utf-8"))
    combined.update(b"\n")
expected_bundle_hash = "sha256:" + combined.hexdigest()
if bundle_sig["bundleHash"] != expected_bundle_hash:
    raise SystemExit("bundle hash verification failed")
expected_bundle_sig = hmac.new(key, expected_bundle_hash.encode("utf-8"), hashlib.sha256).hexdigest()
if bundle_sig["signature"] != expected_bundle_sig:
    raise SystemExit("bundle signature verification failed")
print("bundle signature verify: OK")
PY
  exit 0
fi

if [[ -z "$INPUT" ]]; then
  usage
  exit 2
fi

python3 - "$INPUT" "$PAYLOAD" <<'PY'
import hashlib
import os
import hmac
import json
import sys
from pathlib import Path

envelope = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
payload_path = Path(sys.argv[2]) if sys.argv[2] else None
key = os.environ["CADENCE_SIGNING_KEY"].encode("utf-8")

payload_hash = envelope["payloadHash"]
if payload_path is not None:
    payload_hash = "sha256:" + hashlib.sha256(payload_path.read_bytes()).hexdigest()
    if envelope["payloadHash"] != payload_hash:
        raise SystemExit("payload hash mismatch")

signature = envelope["signature"]
expected = hmac.new(key, payload_hash.encode("utf-8"), hashlib.sha256).hexdigest()
if not hmac.compare_digest(expected, signature):
    raise SystemExit("signature verification failed")
print("signature verify: OK")
PY
