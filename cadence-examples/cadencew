#!/usr/bin/env bash
set -euo pipefail

# Cadence Wrapper (cadencew)
#
# This scaffold wrapper follows the spirit of "Docs as Software":
# - A repo pins the CLI via cadence.lock
# - cadencew resolves the pinned CLI and runs it deterministically
#
# In this offline-friendly scaffold, if no pinned binary is available,
# cadencew builds cadence-core from the local source tree.

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$ROOT_DIR/.cadence/bin"
BIN="$BIN_DIR/cadence"

ensure_bin() {
  # Prefer a local pinned binary if present.
  if [[ -x "$BIN" ]]; then
    return 0
  fi

  # If cadence is already installed globally, use it.
  if command -v cadence >/dev/null 2>&1; then
    return 0
  fi

  mkdir -p "$BIN_DIR"

  # Build from local source tree (repo pack layout).
  LOCAL_CORE="$ROOT_DIR/../cadence-core"
  if [[ -d "$LOCAL_CORE" ]]; then
    echo "cadencew: building cadence-core -> $BIN"
    (cd "$LOCAL_CORE" && go build -o "$BIN" ./cmd/cadence)
    chmod +x "$BIN"
    return 0
  fi

  echo "cadencew: cannot locate cadence-core to build, and no system cadence found" >&2
  exit 127
}

ensure_bin

if [[ -x "$BIN" ]]; then
  exec "$BIN" "$@"
else
  exec cadence "$@"
fi
